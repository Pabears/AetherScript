#!/bin/bash
# aesc pre-commit hook
# 防止手动修改的 impl 文件在未 lock 的情况下被提交
# 一旦提交后没有 lock，下次 aesc-gen 会直接覆盖，丢失修改

set -euo pipefail

LOCK_FILE="aesc.lock"
REPO_ROOT="$(git rev-parse --show-toplevel)"
LOCK_PATH="$REPO_ROOT/$LOCK_FILE"

# 找出本次 commit 中所有被修改的 impl 文件
STAGED_IMPLS=$(git diff --cached --name-only | grep -E 'src/generated/.*\.impl\.ts$' || true)

if [ -z "$STAGED_IMPLS" ]; then
    exit 0  # 没有 impl 文件变更，直接放行
fi

# 如果 aesc.lock 不存在，说明从没 lock 过，所有修改都是未保护的
if [ ! -f "$LOCK_PATH" ]; then
    echo ""
    echo "⚠️  aesc: 检测到 impl 文件变更，但 aesc.lock 不存在"
    echo ""
    echo "   正在提交的 impl 文件："
    echo "$STAGED_IMPLS" | while read -r f; do echo "   - $f"; done
    echo ""
    echo "   如果这些文件是手动修改的，请先 lock："
    echo "   bun src/lock-manager.ts lock <文件路径>"
    echo ""
    echo "   如果这些文件是 aesc-gen 刚生成的（未手改），可以跳过检查："
    echo "   git commit --no-verify"
    echo ""
    exit 1
fi

# 读取 lock 文件中的绝对路径列表
LOCKED_FILES=$(cat "$LOCK_PATH" 2>/dev/null | \
    python3 -c "import sys,json; [print(f) for f in json.load(sys.stdin)]" 2>/dev/null || \
    grep -o '"[^"]*"' "$LOCK_PATH" | tr -d '"' 2>/dev/null || true)

UNLOCKED_IMPLS=()
while IFS= read -r rel_file; do
    [ -z "$rel_file" ] && continue
    ABS_FILE="$REPO_ROOT/$rel_file"
    if ! echo "$LOCKED_FILES" | grep -qF "$ABS_FILE"; then
        UNLOCKED_IMPLS+=("$rel_file")
    fi
done <<< "$STAGED_IMPLS"

if [ ${#UNLOCKED_IMPLS[@]} -gt 0 ]; then
    echo ""
    echo "⚠️  aesc: 以下 impl 文件已修改并准备提交，但未在 aesc.lock 中"
    echo ""
    for f in "${UNLOCKED_IMPLS[@]}"; do
        echo "   - $f"
    done
    echo ""
    echo "   【情况A】文件是手动修改的 → 必须先 lock，防止 aesc-gen 覆盖："
    echo "   bun src/lock-manager.ts lock ${UNLOCKED_IMPLS[*]}"
    echo ""
    echo "   【情况B】文件是 aesc-gen 新生成的（未手改）→ 跳过检查："
    echo "   git commit --no-verify"
    echo ""
    exit 1
fi

echo "✅ aesc: impl lock 状态检查通过"

# ─────────────────────────────────────────────────────────────────
# PRD Append-Only 检查
# docs/prd/*.md 文件不允许删除已有行（物理 append-only）
# 例外1: commit message 以 "prd-amend:" 开头  → 允许修改（需声明意图）
# 例外2: commit message 以 "prd-compaction:" 开头 → 年度归档，跳过所有检查
# ─────────────────────────────────────────────────────────────────

STAGED_PRDS=$(git diff --cached --name-only | grep -E '^docs/prd/[^/]+\.md$' || true)

if [ -z "$STAGED_PRDS" ]; then
    exit 0  # 没有 PRD 文件变更，直接放行
fi

# 读取 commit message（通过 COMMIT_EDITMSG 或 -m 参数）
COMMIT_MSG_FILE="$REPO_ROOT/.git/COMMIT_EDITMSG"
COMMIT_MSG=""
if [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
fi

# 检查豁免前缀
if echo "$COMMIT_MSG" | grep -qE '^prd-compaction:'; then
    echo "✅ aesc: PRD compaction 模式，跳过 append-only 检查"
    exit 0
fi

ALLOW_AMEND=false
if echo "$COMMIT_MSG" | grep -qE '^prd-amend:'; then
    ALLOW_AMEND=true
fi

# 检测是否有 PRD 行被删除
PRD_VIOLATIONS=()
while IFS= read -r prd_file; do
    [ -z "$prd_file" ] && continue
    # 检查 diff 中是否有被删除的行（以 - 开头，排除 diff header）
    DELETED_LINES=$(git diff --cached -- "$prd_file" | grep -E '^-[^-]' || true)
    if [ -n "$DELETED_LINES" ]; then
        PRD_VIOLATIONS+=("$prd_file")
    fi
done <<< "$STAGED_PRDS"

if [ ${#PRD_VIOLATIONS[@]} -gt 0 ]; then
    if [ "$ALLOW_AMEND" = true ]; then
        echo "⚠️  aesc: PRD 文件有行被删除/修改（prd-amend: 模式，已放行）"
        for f in "${PRD_VIOLATIONS[@]}"; do
            echo "   - $f"
        done
        echo "   请确保在文件末尾追加了 <!-- AMENDMENT [date]: reason --> 注释"
    else
        echo ""
        echo "🚫 aesc: PRD Append-Only 违规！以下文件有行被删除："
        echo ""
        for f in "${PRD_VIOLATIONS[@]}"; do
            echo "   - $f"
        done
        echo ""
        echo "   PRD 文件物理上不允许删除已有行。可选方案："
        echo "   【追加】在文件末尾新增内容（推荐）"
        echo "   【修正】使用 prd-amend: 前缀声明修改意图："
        echo "   git commit -m 'prd-amend: fix typo in outputPath description'"
        echo "   【归档】年度归档使用 prd-compaction: 前缀"
        echo ""
        exit 1
    fi
fi

echo "✅ aesc: PRD append-only 检查通过"
exit 0
