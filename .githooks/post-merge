#!/bin/bash
# aesc post-merge hook（git pull / git merge 后触发）
# 当拉取的代码中包含 impl 文件变更时，提醒检查 lock 状态

set -euo pipefail

# 找出本次 merge 中变更的 impl 文件
CHANGED_IMPLS=$(git diff ORIG_HEAD HEAD --name-only 2>/dev/null | \
    grep -E 'src/generated/.*\.impl\.ts$' || true)

CHANGED_LOCK=$(git diff ORIG_HEAD HEAD --name-only 2>/dev/null | \
    grep -E '^aesc\.lock$' || true)

if [ -z "$CHANGED_IMPLS" ]; then
    exit 0  # 没有 impl 变更，无需提醒
fi

echo ""
echo "📦 aesc: 本次 pull 包含以下 impl 文件变更："
echo "$CHANGED_IMPLS" | while read -r f; do echo "   - $f"; done
echo ""

if [ -n "$CHANGED_LOCK" ]; then
    echo "✅ aesc.lock 也已同步更新，lock 状态正确。"
else
    echo "⚠️  aesc.lock 未随本次 pull 更新。"
    echo ""
    echo "   请确认这些 impl 的保护状态："
    echo "   bun src/lock-manager.ts list"
    echo ""
    echo "   如果 impl 中包含手动修改，请补充 lock："
    echo "   bun src/lock-manager.ts lock <文件路径>"
fi
echo ""
