#!/bin/bash
# aesc pre-push hook
# 检测 docs/prd/ 中是否有重复的 NNN 编号
# 防止并行分支同时新建了相同编号的 PRD

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PRD_DIR="$REPO_ROOT/docs/prd"

if [ ! -d "$PRD_DIR" ]; then
    exit 0  # 没有 PRD 目录，直接放行
fi

# 提取所有 docs/prd/NNN-*.md 的编号（不含 archive 子目录）
NUMBERS=$(find "$PRD_DIR" -maxdepth 1 -name '[0-9][0-9][0-9]-*.md' \
    | xargs -I{} basename {} \
    | grep -oE '^[0-9]+' \
    | sort)

# 检查是否有重复
DUPLICATES=$(echo "$NUMBERS" | sort | uniq -d)

if [ -n "$DUPLICATES" ]; then
    echo ""
    echo "🚫 aesc: PRD 编号冲突！以下编号出现了多次："
    echo ""
    for num in $DUPLICATES; do
        echo "   NNN = $num:"
        find "$PRD_DIR" -maxdepth 1 -name "${num}-*.md" | while read -r f; do
            echo "     - $(basename "$f")"
        done
    done
    echo ""
    echo "   请 rebase 你的分支并将冲突的 PRD 重新编号后再 push。"
    echo ""
    exit 1
fi

echo "✅ aesc: PRD 编号无冲突"
exit 0
